<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (project) { %>
        <h2><%= project.title %></h2>
        <p><strong>Description:</strong> <%= project.description %></p>
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

        <p><strong>Volunteers:</strong> <%= volunteerCount %> <%= volunteerCount === 1 ? 'person has' : 'people have' %> signed up for this project.</p>

        <% if (user) { %>
            <% if (isVolunteer) { %>
                <p class="volunteer-status">✅ You are volunteering for this project.</p>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit" class="btn btn-secondary">Remove me as a volunteer</button>
                </form>
            <% } else { %>
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit" class="btn btn-primary">Volunteer for this project</button>
                </form>
            <% } %>
        <% } %>

    <% } else { %>
        <p>Service project not found.</p>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Update Project</a></p>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>


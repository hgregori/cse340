<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Welcome to our users page!</h2>
    <p>You can find our users below:</p>

    <ul>
        <% users.forEach(user => { %>
            <li>
                <%= user.user_id %> |
                <%= user.name %> |
                <%= user.email %> |
                <%= user.role_name %>
            </li>
        <% }) %>
    </ul>
